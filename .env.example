# Copier ce fichier en .env.local puis remplir les valeurs.
# Sans SHOPIFY_STORE_DOMAIN, le site affiche les produits de démo.
# Pour tester avec la boutique de démo publique de Shopify : SHOPIFY_STORE_DOMAIN=mock.shop

# ── Site (lecture du catalogue + panier) ───────────────────────────────────
# Domaine .myshopify.com de la boutique (pas le nom de domaine public)
SHOPIFY_STORE_DOMAIN=millie-magic-world.myshopify.com
# Jeton public Storefront API (canal de vente "Headless" → Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Collection dont les pièces s'affichent sur l'accueil (ordre manuel)
SHOPIFY_FEATURED_COLLECTION=selection-atelier
# SHOPIFY_API_VERSION=2026-04

# ── Script npm run shopify:setup uniquement (ne pas mettre sur Vercel) ─────
# Soit un jeton admin (shpat_...), soit l'identifiant + secret de l'app du Dev Dashboard.
# Droits nécessaires : write_products, read_publications, write_publications
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
